---
import "../styles/global.css";
import { site, apps, type AppKey } from "../config";

interface Props {
  title?: string;
  description?: string;
  /** App que promociona la página: define el Smart App Banner y el JSON-LD. */
  app?: AppKey;
}

const {
  title = site.name,
  description = site.description,
  app = "customer",
} = Astro.props;
const promoted = apps[app];
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL("/og-image.png", site.url).toString();
// Safari muestra "Abrir" si la app está instalada o "Ver" si no. Las páginas
// de /runner son de la app de proveedores, así que ahí no corresponde.
const showAppBanner = !Astro.url.pathname.startsWith("/runner");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: promoted.name,
  operatingSystem: "iOS, Android",
  applicationCategory: "MobileApplication",
  url: app === "customer" ? site.url : canonical,
  installUrl: [promoted.ios.url, promoted.android.url],
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#29617b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      showAppBanner && (
        <meta name="apple-itunes-app" content={`app-id=${promoted.ios.appId}`} />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
