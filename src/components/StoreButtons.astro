---
import { apps, type AppKey } from "../config";

interface Props {
  app?: AppKey;
}

const { app = "customer" } = Astro.props;
const { ios, android, deepLink } = apps[app];
---

<div
  class="flex flex-col sm:flex-row items-center gap-4"
  data-store-buttons
  data-deep-link={deepLink}
  data-android-package={android.packageName}
>
  <a
    href={ios.url}
    data-store="ios"
    class="store-btn transition-transform hover:scale-[1.03] focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded-lg"
    aria-label={ios.alt}
  >
    <img src={ios.badge} alt={ios.alt} class="h-14 w-auto" />
  </a>
  <a
    href={android.url}
    data-store="android"
    class="store-btn transition-transform hover:scale-[1.03] focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded-lg"
    aria-label={android.alt}
  >
    <img src={android.badge} alt={android.alt} class="h-14 w-auto" />
  </a>
</div>

<script>
  import "../scripts/smart-link";
</script>
