---
import { apps, type AppKey } from "../config";

interface Props {
  app?: AppKey;
  /** App Link que abre el botón de Play si la app está instalada; por defecto, el de `app`. */
  deepLink?: string;
  /** Insignias centradas con tamaño adaptable para la página de vinculación. */
  sideBySide?: boolean;
}

const { app = "customer", sideBySide = false } = Astro.props;
const { ios, android } = apps[app];
const deepLink = Astro.props.deepLink ?? apps[app].deepLink;

---

<div
  class:list={["store-buttons", { "store-buttons-side-by-side": sideBySide }]}
  data-store-buttons
  data-deep-link={deepLink}
  data-android-package={android.packageName}
>
  <a
    href={ios.url}
    data-store="ios"
    class="store-btn"
    aria-label={ios.alt}
  >
    <img src={ios.badge} alt={ios.alt} width="168" height="56" />
  </a>
  <a
    href={android.url}
    data-store="android"
    class="store-btn"
    aria-label={android.alt}
  >
    <img src={android.badge} alt={android.alt} width="189" height="56" />
  </a>
</div>

<script>
  import "../scripts/smart-link";
</script>

<style>
  .store-buttons-side-by-side { justify-content: center; gap: .75rem; }
  /* Fit both badges within Legal's 3rem gutters, preserving the 40px minimum. */
  .store-buttons-side-by-side .store-btn img {
    height: clamp(2.5rem, calc((100vw - 3.75rem) / 6.4), 3.5rem);
    width: auto;
  }
</style>
