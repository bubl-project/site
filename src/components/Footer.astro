---
import { site } from "../config";
interface Props { links: { href: string; label: string }[]; }
const { links } = Astro.props;
---
<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-brand"><a class="brand" href="/" aria-label="Bubl — inicio"><img src="/brand/wordmark-light.webp" alt="Bubl" width="85" height="49" loading="lazy" /></a></div>
    <nav aria-label="Enlaces del pie de página">{links.map(({ href, label }) => <a href={href}>{label}</a>)}</nav>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Hecho para que sigas con tu día.</span></div>
</footer>
